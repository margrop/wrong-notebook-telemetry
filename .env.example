# 本地使用绝对路径；远端使用 Turso 的 libsql:// 地址。
TURSO_DATABASE_URL=file:/absolute/path/to/telemetry.db
TURSO_AUTH_TOKEN=

# 使用 npm run password:hash 交互生成 bcrypt 哈希，不在命令行输入密码。
# Next.js 的 .env.local 须把哈希中的美元符号转义为 \$，平台环境变量使用原始值。
DASHBOARD_PASSWORD_HASH=
# 独立的随机密钥，至少 32 字符；轮换后全部会话失效。
DASHBOARD_SESSION_SECRET=
# Vercel Cron 自动以 Authorization: Bearer 发送，至少 32 字符。
CRON_SECRET=

# 留空沿用数据库设置；true 强制暂停；false 强制解除暂停。
INGEST_PAUSED=
# 与数据库停用列表取并集。
INGEST_DISABLED_VERSIONS=
INGEST_DISABLED_SCHEMAS=

# 默认只信任 Vercel 清洗的 x-vercel-forwarded-for；自建反向代理须先清洗请求头。
TRUST_PROXY_HEADERS=false

# 可选：自动降频预算，留空关闭对应指标，避免把估算冒充平台实际用量。
MONTHLY_BATCH_BUDGET=
STORAGE_ROW_BUDGET=
DATABASE_BYTE_BUDGET=
QUOTA_WARNING_RATIO=0.7
